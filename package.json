{
  "name": "flowfig",
  "version": "0.4.0",
  "description": "Your coding agent draws animated diagrams from your code, and flowfig checks them. One animated SVG for a GitHub README, PR or issue, and a React player. Set up Claude Code, Cursor, GitHub Copilot, Codex, Gemini CLI, Windsurf and Kiro with npx flowfig init.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamalvisng/flowfig.git"
  },
  "homepage": "https://github.com/iamalvisng/flowfig#readme",
  "bugs": {
    "url": "https://github.com/iamalvisng/flowfig/issues"
  },
  "keywords": [
    "diagram",
    "sequence-diagram",
    "architecture",
    "architecture-diagram",
    "svg",
    "animation",
    "ai-agents",
    "coding-agent",
    "claude-code",
    "cursor",
    "github-copilot",
    "codex",
    "gemini-cli",
    "windsurf",
    "kiro",
    "agents-md",
    "readme",
    "react"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./svg": {
      "types": "./dist/svg.d.ts",
      "default": "./dist/svg.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "default": "./dist/verify.js"
    }
  },
  "bin": {
    "flowfig": "dist/cli.js"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepack": "npm run build",
    "dev": "vite --open",
    "export": "node scripts/export.mjs",
    "format:check": "prettier --check .",
    "svg": "node scripts/figure-svg.mjs",
    "test": "npm run build && node --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.50.0",
    "prettier": "^3.7.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "files": [
    "dist"
  ]
}
